# Maintainer: Arc Academy <contact@arcacademy.sh>
pkgname=arct-terminal
pkgver=1.1.0
pkgrel=1
pkgdesc="Learn the command line by using it: guided lessons, explanations and a safety guard"
arch=('x86_64' 'aarch64')
url="https://arcacademy.sh"
license=('GPL-2.0-only')
depends=()
makedepends=('cargo' 'git')
provides=('arct')
conflicts=('arct')
source=("arc-academy-terminal::git+https://github.com/0xdxn/arc-academy-terminal.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cd "$srcdir/arc-academy-terminal"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --locked -p arct-cli --target-dir=target
}

check() {
  cd "$srcdir/arc-academy-terminal"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --release --locked --target-dir=target
}

package() {
  cd "$srcdir/arc-academy-terminal"
  install -Dm755 "target/release/arct" "$pkgdir/usr/bin/arct"
  install -Dm644 README.md "$pkgdir/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
